{
    "name": "ezsystems/ezplatform-automated-translation",
    "description": "Ibexa 5 Automated Translation Bundle provides interfaces to automatically translate a new content translation from different translation providers.",
    "keywords": [
        "novactive",
        "AlmaviaCX",
        "ibexa",
        "translation",
        "deepl",
        "googletranslate"
    ],
    "homepage": "https://github.com/ezsystems/ezplatform-automated-translation",
    "type": "ezplatform-bundle",
    "authors": [
        {
            "name": "Novactive",
            "homepage": "http://www.novactive.us",
            "email": "s.morel@novactive.com"
        }
    ],
    "license": [
        "GPL-2.0"
    ],
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-libxml": "*",
        "ibexa/oss": "^5.0",
        "symfony/yaml": "^7.3",
        "symfony/routing": "^7.3",
        "symfony/console": "^7.3",
        "symfony/form": "^7.3",
        "symfony/http-foundation": "^7.3",
        "symfony/event-dispatcher": "^7.3",
        "guzzlehttp/guzzle": "^6.3.0",
        "http-interop/http-factory-guzzle": "^1.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.2",
        "phpmd/phpmd": "^2.6",
        "friendsofphp/php-cs-fixer": "^3.10",
        "dg/bypass-finals": "^1.3",
        "phpunit/phpunit": "^9|^10|^12.5"
    },
    "TODO": {
        "phpunit/phpunit": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "EzSystems\\EzPlatformAutomatedTranslation\\": "lib",
            "EzSystems\\EzPlatformAutomatedTranslationBundle\\": "bundle",
            "EzSystems\\EzPlatformAutomatedTranslationBundle\\Tests\\": "tests"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EzSystems\\EzPlatformAutomatedTranslation\\Tests\\": "tests/lib/",
            "EzSystems\\EzPlatformAutomatedTranslationBundle\\Tests\\": "tests/bundle/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.2.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "ibexa/post-install": true,
            "php-http/discovery": true
        }
    }
}
